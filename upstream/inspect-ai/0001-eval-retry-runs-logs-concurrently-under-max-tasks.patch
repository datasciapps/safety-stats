+def _group_retries(
+    retries: list[tuple[int, PreviousTask, dict[str, Any]]],
+) -> list[list[tuple[int, PreviousTask, dict[str, Any]]]]:
+    """Group retries of one eval whose settings are equal, in order of first appearance.
+
+    A retry joins the first group with equal settings that does not already
+    hold its task id (results are matched to retries by task id). Settings that
+    don't compare equal (an object without `__eq__`) put a retry in a group of
+    its own, so it runs as an eval of its own, as every retry did before.
+    """
+    groups: list[list[tuple[int, PreviousTask, dict[str, Any]]]] = []
+    for retry in retries:
+        _, previous_task, settings = retry
+        key = _retry_settings_key(previous_task, settings)
+        for group in groups:
+            first = group[0]
+            if _retry_settings_key(first[1], first[2]) == key and all(
+                other.id != previous_task.id for _, other, _ in group
+            ):
+                group.append(retry)
+                break
+        else:
+            groups.append([retry])
+    return groups
+
+
+def _retry_settings_key(
+    previous_task: PreviousTask, settings: dict[str, Any]
+) -> dict[str, Any]:
+    # Model instances are not always memoized (mockllm never is), so compare the
+    # models as the log records them; Epochs has no __eq__, so compare what it
+    # was built from
+    spec = previous_task.log.eval
+    key = {
+        name: (value.epochs, value._reducer_spec)
+        if isinstance(value, Epochs)
+        else value
+        for name, value in settings.items()
+        if name not in ("model", "model_roles")
+    }
+    key["model"] = (
+        spec.model,
+        spec.model_generate_config,
+        spec.model_base_url,
+        spec.model_args,
+    )
+    key["model_roles"] = spec.model_roles
+    # only logs that ran together run together again: logs of separate evals
+    # stay separate evals, even with equal settings
+    key["run_id"] = spec.run_id
+    return key
 
 
