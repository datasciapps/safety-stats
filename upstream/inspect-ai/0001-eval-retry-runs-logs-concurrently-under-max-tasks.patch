+        # a Ctrl-C leaves the scope cancelled after the interrupted eval)
+        await anyio.lowlevel.checkpoint_if_cancelled()
+        retried_logs = await eval_async(
+            tasks=[previous_task for _, previous_task, _ in group],
+            # with one task the eval-level task args are that task's, as before;
+            # with several, each PreviousTask carries its own
+            task_args=group[0][1].task_args if len(group) == 1 else {},
+            **group[0][2],
+        )
+        retried_by_task_id = {log.eval.task_id: log for log in retried_logs}
+        for i, previous_task, _ in group:
+            eval_logs[i] = retried_by_task_id[previous_task.id]
 
