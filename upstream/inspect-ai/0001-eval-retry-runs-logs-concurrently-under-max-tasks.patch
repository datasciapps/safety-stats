diff --git a/tests/test_retry.py b/tests/test_retry.py
index f15867213..5ca0f67bf 100644
--- a/tests/test_retry.py
+++ b/tests/test_retry.py
@@ -1000,3 +1000,90 @@ def test_eval_retry_model_cost_config(tmp_path: Path) -> None:
         [log.location, "--model-cost-config", str(pricing_file), "--display", "none"],
     )
     assert res.exit_code == 0, f"CLI retry failed: {res.output}\n{res.exception}"
+
+
+# Set while the first run of `retry_arm` should fail. An environment variable,
+# because eval_retry loads this file again as a task file, as a separate module.
+_RETRY_ARM_FAIL = "INSPECT_TEST_RETRY_ARM_FAIL"
+
+
+@solver
+def sleep_then_fail_while_flagged(seconds: float):
+    async def solve(state: TaskState, generate: Any) -> TaskState:
+        import anyio
+
+        await anyio.sleep(seconds)
+        if os.environ.get(_RETRY_ARM_FAIL) == "1":
+            raise RuntimeError("the first run fails")
+        return state
+
+    return solve
+
+
+@task
+def retry_arm(arm: str = "a"):
+    return Task(
+        dataset=[Sample(input=f"arm {arm}", target="x")],
+        solver=sleep_then_fail_while_flagged(1.0),
+    )
+
+
+def _running_together(logs: list[Any]) -> bool:
+    from datetime import datetime
+
+    starts = [datetime.fromisoformat(log.stats.started_at) for log in logs]
+    ends = [datetime.fromisoformat(log.stats.completed_at) for log in logs]
+    return max(starts) < min(ends)
+
+
+def test_eval_retry_runs_several_logs_concurrently_under_max_tasks(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setenv(_RETRY_ARM_FAIL, "1")
+    logs = eval(
+        [retry_arm(arm="a"), retry_arm(arm="b")],
+        model="mockllm/model",
+        max_tasks=2,
+        log_dir=str(tmp_path),
+        display="none",
+    )
+    assert [log.status for log in logs] == ["error", "error"]
+    assert _running_together(logs)
+
+    monkeypatch.delenv(_RETRY_ARM_FAIL)
+    retried = eval_retry(logs, log_dir=str(tmp_path), display="none")
+
+    # one log per retried log, in the order given, each with its own task args
+    assert [log.status for log in retried] == ["success", "success"]
+    assert [log.eval.task_id for log in retried] == [log.eval.task_id for log in logs]
+    assert [log.eval.task_args["arm"] for log in retried] == ["a", "b"]
+    # the original eval ran both tasks at once under max_tasks=2, so does the retry
+    assert _running_together(retried)
+
+
+def test_eval_retry_runs_logs_with_different_models_one_after_another(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    monkeypatch.setenv(_RETRY_ARM_FAIL, "1")
+    logs = eval(
+        retry_arm(arm="a"),
+        model=["mockllm/model", "mockllm/other"],
+        max_tasks=2,
+        log_dir=str(tmp_path),
+        display="none",
+    )
+    assert [log.status for log in logs] == ["error", "error"]
+    assert _running_together(logs)
+
+    monkeypatch.delenv(_RETRY_ARM_FAIL)
+    retried = eval_retry(logs, log_dir=str(tmp_path), display="none")
+
+    # the eval-level model differs, so each log is retried as an eval of its own,
+    # keeping its model
+    assert [log.status for log in retried] == ["success", "success"]
+    assert [log.eval.model for log in retried] == [log.eval.model for log in logs]
+    assert sorted(log.eval.model for log in retried) == [
+        "mockllm/model",
+        "mockllm/other",
+    ]
+    assert not _running_together(retried)
